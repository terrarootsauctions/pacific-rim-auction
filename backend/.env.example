# Copy this file to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=development

# Generate a real random secret for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_ENV

# Local dev default (SQLite). For production, point this at a managed Postgres, e.g.:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./pacific_rim.db

# First Hawaiian Bank, Lihue Branch (receive-only settlement rail)
FHB_ROUTING_NUMBER=121301015
FHB_ACCOUNT_NUMBER=
# Shared secret that First Hawaiian Bank's credit notifications are signed with.
# Get this from the bank when they issue the notification specification.
FHB_WEBHOOK_SECRET=

COUNTRY_TARGET=190

PLATFORM_FEE_MIN=0.03
PLATFORM_FEE_MAX=0.05

# Get this from your Reply.io account: Settings > API Key
REPLY_IO_API_KEY=

# First admin account. Set both, start the service once, then DELETE the password.
# Public signup can never create an admin.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Website origins allowed to call the API (comma-separated)
CORS_ORIGINS=https://pacificrimauctions.com,https://www.pacificrimauctions.com

# Memory Lock signing secret (32+ characters). Render generates one for you.
# BACK THIS UP: it derives the signing keys. Lose it and past records can no
# longer be verified by this service; change it and old signatures stop matching.
MEMORY_SIGNING_SECRET=
MEMORY_KEY_VERSION=1

# Bid engine defaults (the evolution engine may adjust within hard bounds)
MIN_BID_INCREMENT_MINOR=100
ANTI_SNIPE_WINDOW_SECONDS=30
ANTI_SNIPE_EXTENSION_SECONDS=30

# Background loop
BACKGROUND_ENABLED=true
AUCTION_CLOSE_INTERVAL_SECONDS=15
MEMORY_VERIFY_INTERVAL_SECONDS=3600
